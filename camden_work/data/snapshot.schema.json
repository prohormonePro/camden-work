{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:camden-work:snapshot:1",
  "title": "Controller snapshot structural envelope, version 1",
  "description": "Structural interchange envelope. Row bodies retain the version-1 controller fields. Conformance does not verify effects, authenticate the producer, authorize import execution or establish completion.",
  "type": "object",
  "required": ["schema", "node", "owner", "works", "grants", "attempts", "observations", "dependencies", "waits", "events", "target_effects", "limits"],
  "properties": {
    "schema": {"const": 1},
    "node": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "owner": {"type": "object", "required": ["singleton", "epoch", "worker", "stopped"], "properties": {"singleton": {"const": 1}, "epoch": {"type": "integer", "minimum": 0}, "worker": {"type": ["string", "null"]}, "stopped": {"enum": [0, 1]}}, "additionalProperties": false},
    "works": {"type": "array", "maxItems": 512, "items": {"type": "object"}},
    "grants": {"type": "array", "maxItems": 128, "items": {"type": "object"}},
    "attempts": {"type": "array", "items": {"type": "object"}},
    "observations": {"type": "array", "items": {"type": "object"}},
    "dependencies": {"type": "array", "items": {"type": "object"}},
    "waits": {"type": "array", "items": {"type": "object"}},
    "events": {"type": "array", "items": {"type": "object"}},
    "target_effects": {"type": "array", "items": {"type": "object"}},
    "limits": {"type": "array", "items": {"type": "string"}},
    "export_target_checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "disposition_checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "all_required_work_verified": {"type": "boolean"},
    "all_required_work_accounted": {"type": "boolean"},
    "export_is_remote_delivery": {"const": false},
    "snapshot_at": {"type": "number"}
  },
  "additionalProperties": false
}
